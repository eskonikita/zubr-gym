	'MODX_SITE_URL' => 'https://' . $production['host'] . '/',
	'MODX_LOG_LEVEL_FATAL' => 0,
	'MODX_LOG_LEVEL_ERROR' => 1,
	'MODX_LOG_LEVEL_WARN' => 2,
	'MODX_LOG_LEVEL_INFO' => 3,
	'MODX_LOG_LEVEL_DEBUG' => 4,
] as $name => $value) {
