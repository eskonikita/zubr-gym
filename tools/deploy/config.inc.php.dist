$config_options = ['session_cookie_secure' => true, 'session_cookie_samesite' => 'Lax'];
$driver_options = [];
$lastInstallTime = 1793187525;
$site_id = 'modx-zubr-gym-production';
$site_sessionname = 'ZUBRPRODSESSION';
$https_port = '443';
$uuid = '38e63d67-7e50-4347-9f09-c078cf5145bb';
$public = $projectRoot . 'public/';
foreach ([
	'MODX_BASE_PATH' => $public,
	'MODX_BASE_URL' => '/',
	'MODX_CORE_PATH' => $public . 'core/',
	'MODX_ASSETS_PATH' => $public . 'assets/',
	'MODX_ASSETS_URL' => '/assets/',
	'MODX_MANAGER_PATH' => $public . 'manager/',
	'MODX_MANAGER_URL' => '/manager/',
	'MODX_CONNECTORS_PATH' => $public . 'connectors/',
	'MODX_CONNECTORS_URL' => '/connectors/',
	'MODX_PROCESSORS_PATH' => $public . 'core/src/Revolution/Processors/',
	'MODX_URL_SCHEME' => 'https://',
