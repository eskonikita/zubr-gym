# MODX / ZUBR GYM. Local HTTP remains available; production uses https://zubr-gym.by.
Options -Indexes
DirectoryIndex index.php
DirectorySlash Off
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType image/x-icon .ico
RewriteEngine On
RewriteBase /

# Let a certificate authority read its challenge before enforcing HTTPS.
RewriteRule ^\.well-known/acme-challenge/ - [L]

# Canonical production host, preserving path and query in a single hop.
RewriteCond %{HTTP_HOST} ^www\.zubr-gym\.by(?::[0-9]+)?$ [NC]
RewriteRule ^ https://zubr-gym.by%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^zubr-gym\.by(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://zubr-gym.by%{REQUEST_URI} [R=301,L,NE]

# Normalize the existing local www alias without requiring a local TLS certificate.
RewriteCond %{HTTP_HOST} ^www\.zubr-gym\.local$ [NC]
RewriteRule ^ http://zubr-gym.local%{REQUEST_URI} [R=301,L,NE]

RewriteRule ^(?:core|setup|_build|_backup|vendor)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:manager|connectors)(?:/|$) - [L]

# Legacy coaches listing needs no separate resource in the manager tree.
RewriteRule ^coaches/?$ /club/coaches/ [R=301,L]
RewriteRule ^coaches/(andrey-parkhomik|andrey-gunda|artem-dzhabaryan|pavel-apanasenok)/?$ /club/coaches/$1/ [R=301,L]

# robots.txt is a MODX resource. The physical file is a safe, closed static-preview fallback.
RewriteRule ^(robots\.txt|sitemap\.xml)$ index.php?q=$1 [L,QSA]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php?q=$1 [L,QSA]

<FilesMatch "(?i)(^config\.core\.php$|\.sql(?:\.gz)?$|\.log$|\.bak$|^\.env)">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule php_module>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
